#!/usr/bin/env bash
# The download of the repository, which is the checkout's deploy/, and asphodel's health check, which says what
# `health` holds. With no `health` asphodel does not answer.
case "$*" in
  *codeload*) cat "$FAKE/deploy.tgz" ;;
  */v1/health*) cat "$FAKE/health" 2>/dev/null || exit 7 ;;
esac
