 export const log = (ev: string, data: Record<string, unknown> = {}) =>
   appendFileSync(LOG, JSON.stringify({ t: Date.now(), pid: process.pid, ev, ...data }) + "\n")
 
+// --- the shard count guard, added for "The chad image built and run" (TIM-553) ---------------
+// A stored message carries the shard it was stored under. Change the count and the runner never polls that
+// shard again: nothing errors, the message just never arrives. So the count is written to the database the
+// first time it is opened, and a daemon with another count refuses to start. PROTO_NO_SHARD_GUARD=1 turns it off.
+export const SHARDS = Number(env.PROTO_SHARDS ?? 300)
+if (env.PROTO_NO_SHARD_GUARD !== "1") {
+  const db = new DatabaseSync(DB)
+  db.exec("CREATE TABLE IF NOT EXISTS chad_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)")
+  const row = db.prepare("SELECT value FROM chad_meta WHERE key = 'shards'").get() as { value: string } | undefined
+  if (row === undefined) db.prepare("INSERT INTO chad_meta VALUES ('shards', ?)").run(String(SHARDS))
+  db.close()
+  if (row !== undefined && Number(row.value) !== SHARDS) {
+    const message = "chad serve: this database was made with " + row.value + " shards and this chad uses " + SHARDS + ". Messages stored under the old count would never be delivered, so chad will not start."
+    log("boot.refused", { stored: Number(row.value), now: SHARDS, message })
+    console.error(message)
+    process.exit(1)
+  }
+}
